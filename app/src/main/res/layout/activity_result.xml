<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvResultTitle"
        android:text="Quiz Completed!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvFinalScore"
        android:text="Your Score: 0 / 10"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- NEW: Show correct answers explicitly -->
    <TextView
        android:id="@+id/tvCorrectAnswers"
        android:text="Correct Answers: 0 out of 10"
        android:textSize="18sp"
        android:textColor="#555555"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvPerformance"
        android:text="Performance feedback here"
        android:textSize="18sp"
        android:textColor="#555555"
        android:layout_marginBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnRetry"
        android:text="Retry Quiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnHome"
        android:text="Back to Categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
